{
  "_comment": "复制此文件为 ecosystem.config.json 并填入真实密钥。ecosystem.config.json 已被 .gitignore 排除。",
  "apps": [
    {
      "name": "jc-zjfa",
      "script": "index.js",
      "cwd": "/root/server",
      "instances": 1,
      "exec_mode": "cluster",
      "env": {
        "NODE_ENV": "production",
        "BEHIND_PROXY": "1",
        "DEEPSEEK_API_KEY": "<YOUR_DEEPSEEK_API_KEY>",
        "DOUBAO_API_KEY": "<YOUR_DOUBAO_API_KEY>",
        "MIDOU_MOBILE": "<MIDOU_MOBILE>",
        "MIDOU_PASSWORD": "<MIDOU_PASSWORD>",
        "MIDOU_BACKUP_MOBILE": "<MIDOU_BACKUP_MOBILE>",
        "MIDOU_BACKUP_PASSWORD": "<MIDOU_BACKUP_PASSWORD>",
        "ALERT_ENABLED": "true",
        "ALERT_RECIPIENT": "<ALERT_EMAIL>",
        "ALERT_SMTP_HOST": "smtp.qq.com",
        "ALERT_SMTP_PORT": "465",
        "ALERT_SMTP_USER": "<SMTP_USER>",
        "ALERT_SMTP_PASS": "<SMTP_PASS>",
        "FEATURE_RICH_PROMPT": "0",
        "DATA_JSON_AGGRESSIVE_CACHE": "1"
      },
      "max_memory_restart": "1800M",
      "min_uptime": "10000",
      "max_restarts": 5,
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "./logs/error.log",
      "out_file": "./logs/out.log",
      "merge_logs": true,
      "autorestart": true,
      "watch": false
    },
    {
      "name": "jc-sync",
      "script": "data_sync.js",
      "cwd": "/root/server",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "BEHIND_PROXY": "1",
        "DEEPSEEK_API_KEY": "<YOUR_DEEPSEEK_API_KEY>",
        "DOUBAO_API_KEY": "<YOUR_DOUBAO_API_KEY>",
        "MIDOU_MOBILE": "<MIDOU_MOBILE>",
        "MIDOU_PASSWORD": "<MIDOU_PASSWORD>",
        "MIDOU_BACKUP_MOBILE": "<MIDOU_BACKUP_MOBILE>",
        "MIDOU_BACKUP_PASSWORD": "<MIDOU_BACKUP_PASSWORD>",
        "ALERT_ENABLED": "true",
        "ALERT_RECIPIENT": "<ALERT_EMAIL>",
        "ALERT_SMTP_HOST": "smtp.qq.com",
        "ALERT_SMTP_PORT": "465",
        "ALERT_SMTP_USER": "<SMTP_USER>",
        "ALERT_SMTP_PASS": "<SMTP_PASS>",
        "FEATURE_RICH_PROMPT": "0",
        "DATA_JSON_AGGRESSIVE_CACHE": "0"
      },
      "max_memory_restart": "1800M",
      "min_uptime": "10000",
      "max_restarts": 5,
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "./logs/sync_error.log",
      "out_file": "./logs/sync_out.log",
      "merge_logs": true,
      "autorestart": true,
      "watch": false
    },
    {
      "name": "jc-scheduler",
      "script": "scheduler_v2.js",
      "cwd": "/root/server",
      "instances": 1,
      "exec_mode": "fork",
      "env": {
        "NODE_ENV": "production",
        "BEHIND_PROXY": "1",
        "FEATURE_ENGINE_ENABLED": "1",
        "DATA_FUSION_ENABLED": "1",
        "FEATURE_RICH_PROMPT": "0"
      },
      "max_memory_restart": "2048M",
      "min_uptime": "10000",
      "max_restarts": 10,
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "./logs/scheduler_error.log",
      "out_file": "./logs/scheduler_out.log",
      "merge_logs": true,
      "autorestart": true,
      "watch": false
    }
  ]
}
