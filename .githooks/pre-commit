#!/usr/bin/env sh
# ============================================================
# pre-commit hook — JC-ZJFA
# 提交前自动执行 lint + 核心单元测试
# ============================================================

set -e

echo ""
echo "┌──────────────────────────────────────────────┐"
echo "│  pre-commit: 开始检查...                      │"
echo "└──────────────────────────────────────────────┘"
echo ""

# ── Step 1: ESLint ──
echo "[1/3] ESLint 代码规范检查..."
npx eslint "server/**/*.js" "preview/js/**/*.js" "preview/*.js" "scripts/*.js" --quiet
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ ESLint 检查未通过，请修复后重试。"
  echo "   提示: 运行 npm run lint:fix 自动修复部分问题。"
  exit 1
fi
echo "  ✅ ESLint 通过"

# ── Step 2: P0 核心单元测试 ──
echo "[2/3] P0 核心单元测试..."
CACHE_WARMER_FAST=1 npx jest --testPathPattern="server/tests/(index_api|data_sync|prediction_log|database|scheduler_v2|cache|pk_scorer|plan-generator)" --forceExit --no-coverage
if [ $? -ne 0 ]; then
  echo ""
  echo "❌ P0 单元测试未通过，请修复后重试。"
  exit 1
fi
echo "  ✅ P0 测试通过"

# ── Step 3: 格式化检查（仅检查本次变更文件）──
echo "[3/3] 格式化检查..."
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' || true)
if [ -n "$STAGED_JS" ]; then
  echo "$STAGED_JS" | xargs npx prettier --check --loglevel error 2>&1
  if [ $? -ne 0 ]; then
    echo ""
    echo "⚠️  本次变更的代码格式不一致，请运行 npm run format 进行格式化。"
    exit 1
  fi
else
  echo "  (无 JS 文件变更，跳过格式检查)"
fi
echo "  ✅ 格式检查通过"

echo ""
echo "┌──────────────────────────────────────────────┐"
echo "│  ✅ pre-commit 全部通过，允许提交。            │"
echo "└──────────────────────────────────────────────┘"
echo ""
