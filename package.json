{
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express-rate-limit": "^8.5.2",
    "iconv-lite": "^0.7.2",
    "nodemailer": "^8.0.9",
    "puppeteer": "^25.1.0",
    "ssh2": "^1.17.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@playwright/test": "^1.60.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.3.0"
  },
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --config jest.coverage.config.js --coverage --forceExit --no-cache",
    "test:coverage:gaps": "node scripts/coverage-gaps.js",
    "test:p0": "jest --testPathPattern=\"server/tests/(index_api|api-contract|data_sync|prediction_log|database|database-adapter-real|atomic-write|backfill-pipeline|scheduler_v2|cache|pk_scorer|pk-decision-fields|ranking-list-pk-fields|backtest-pk-judge|plan-generator|error-codes|file-utils|odds-match-handler|odds-data-integrity|bet-scheme-filters)\"",
    "test:p1": "jest --testPathPattern=\"server/tests/(ai_daemon|ai-timing|main-fusion|health|http-utils|websocket|midou|cloudfunctions|shadow-account|blueprint-api|blueprint-prediction-adapter|blueprint-outcome-backfill|feature-engine|match-context-collector|market-overlay|model-dashboard-reliability|unified-predictions-inflow|fallback-paths)\"",
    "test:p2": "jest --testPathPattern=\"gongshoudao/tests|server/tests/(data-pipeline-e2e|file-corruption|consistency-check|pk-snapshot-attribution)\"",
    "test:frontend": "jest --testPathPattern=\"preview/tests\" --forceExit --no-coverage",
    "test:modals": "jest --testPathPattern=\"preview/tests/(modals-render-contract|modal-loading-states)\" --forceExit --no-coverage",
    "test:components": "jest --testPathPattern=\"preview/tests/(charts-render-contract|tables-render-contract)\" --forceExit --no-coverage",
    "test:interaction": "jest --testPathPattern=\"preview/tests/(filter-interaction|dynamic-load-states|state-consistency)\" --forceExit --no-coverage",
    "test:scheme-flow": "jest preview/tests/scheme-flow.test.js --forceExit --no-coverage",
    "test:odds-score": "jest preview/tests/odds-score-status.test.js --forceExit --no-coverage",
    "test:login-auth": "jest preview/tests/login-auth.test.js --forceExit --no-coverage",
    "test:api-contract": "jest --testPathPattern=\"server/tests/(api-contract|blueprint-api|odds-match-handler)\" --forceExit --no-coverage",
    "test:routes": "jest --testPathPattern=\"preview/tests/(main-fusion-routes|plans-render-contract|blueprint-pages|main-fusion)\" --forceExit --no-coverage",
    "test:critical": "npm run test:p0 && npm run test:api-contract && npm run test:routes",
    "lint": "eslint \"server/**/*.js\" \"preview/js/**/*.js\" \"preview/*.js\" \"scripts/*.js\"",
    "lint:fix": "eslint --fix \"server/**/*.js\" \"preview/js/**/*.js\" \"preview/*.js\" \"scripts/*.js\"",
    "format": "prettier --write \"server/**/*.js\" \"preview/js/**/*.js\" \"preview/*.js\" \"scripts/*.js\"",
    "format:check": "prettier --check \"server/**/*.js\" \"preview/js/**/*.js\" \"preview/*.js\" \"scripts/*.js\" --log-level error",
    "test:e2e": "npx playwright test",
    "test:e2e:critical": "npx playwright test preview/tests/e2e/main.spec.js preview/tests/e2e/tabs.spec.js preview/tests/e2e/plans.spec.js preview/tests/e2e/critical-flows.spec.js",
    "test:e2e:perf": "npx playwright test preview/tests/e2e/perf-pages.spec.js --workers=1 --reporter=line",
    "test:e2e:perf:gate": "cmd /c \"npx playwright test preview/tests/e2e/perf-pages.spec.js --workers=1 --reporter=json > E:\\JC-ZJFA\\.codebuddy\\e2e_perf_report.json\" && node scripts/e2e-perf-gate.js E:/JC-ZJFA/.codebuddy/e2e_perf_report.json 3000",
    "preflight:perf": "npm run test:e2e:critical && npm run test:e2e:perf:gate",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:report": "npx playwright show-report",
    "test:e2e:error-handling": "npx playwright test preview/tests/e2e/api-error-handling.spec.js preview/tests/e2e/module-loading.spec.js preview/tests/e2e/auth-flow.spec.js --workers=1",
    "test:e2e:qos": "npx playwright test preview/tests/e2e/asset-scan.spec.js preview/tests/e2e/ws-resilience.spec.js preview/tests/e2e/scheme-interaction.spec.js preview/tests/e2e/mobile-viewport.spec.js --workers=1",
    "test:e2e:all": "npx playwright test --workers=1",
    "test:contract": "jest preview/tests/contract-snapshot.test.js --forceExit --no-coverage",
    "test:smoke": "jest --testPathPattern=\"smoke_api\" --testPathIgnorePatterns=node_modules --forceExit --no-coverage",
    "setup:githooks": "git config core.hooksPath .githooks",
    "preflight": "powershell -ExecutionPolicy Bypass -File scripts/release-preflight.ps1",
    "preflight:full": "npm run preflight && npm run test:p1 && npm run test:p2 && npm run test:frontend && npm run test:api-contract && npm run benchmark",
    "test:all:fast": "powershell -Command \"$env:CACHE_WARMER_FAST='1'; jest --forceExit --no-coverage\"",
    "benchmark": "node scripts/benchmark_gongshoudao.js --mode=gate",
    "benchmark:refresh": "node scripts/benchmark_gongshoudao.js --mode=refresh",
    "benchmark:cold": "node scripts/benchmark_gongshoudao.js --mode=cold --network"
  }
}
