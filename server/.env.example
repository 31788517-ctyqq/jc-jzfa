# ============ 竞彩推荐监控 - 环境配置模板 ============
PORT=3000
NODE_ENV=production

# 第三方数据源凭证（必填）
MIDOU_BASE_URL=https://midou310.com/mdsj
MIDOU_MOBILE=your_mobile
MIDOU_PASSWORD=your_password

# CORS 允许域名（逗号分隔，生产环境改为实际域名）
ALLOWED_ORIGINS=http://localhost:3000

# ── 支付宝证书模式（沙箱示例；私钥和证书文件不要提交 Git）──
ALIPAY_ENABLED=false
ALIPAY_MODE=cert
ALIPAY_SANDBOX=true
ALIPAY_APP_ID=2021006161653361
ALIPAY_SELLER_ID=2088040915526659
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_NOTIFY_URL=https://zj.100qiu.com/api/payments/notify
ALIPAY_RETURN_URL=https://zj.100qiu.com/preview/index.html#payment-result
ALIPAY_APP_PRIVATE_KEY_PATH=/root/server/keys/alipay/alipay_app_private_key.pem
ALIPAY_APP_CERT_PATH=/root/server/keys/alipay/appCertPublicKey_2021006161653361.crt
ALIPAY_PUBLIC_CERT_PATH=/root/server/keys/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=/root/server/keys/alipay/alipayRootCert.crt

# 定时爬取配置
AUTO_CRAWL_ENABLED=false
AUTO_CRAWL_CRON=0 7 * * *

# ── 邮件告警配置 ──
# 告警总开关（false 禁用）
ALERT_ENABLED=true
# 收件人邮箱
ALERT_RECIPIENT=31788517@qq.com
# QQ邮箱 SMTP 配置（需在QQ邮箱设置中开启SMTP服务并获取授权码）
ALERT_SMTP_HOST=smtp.qq.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=your_sender@qq.com
ALERT_SMTP_PASS=your_smtp_authorization_code
