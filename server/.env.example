# ============ 竞彩推荐监控 - 环境配置模板 ============
PORT=3000
NODE_ENV=production

# 第三方数据源凭证（必填）
MIDOU_BASE_URL=https://midou310.com/mdsj
MIDOU_MOBILE=your_mobile
MIDOU_PASSWORD=your_password

# CORS 允许域名（逗号分隔，生产环境改为实际域名）
ALLOWED_ORIGINS=http://localhost:3000

# ── 支付宝支付配置 ──
# 模式: cert(新版RSA2证书) | key(新版RSA2密钥) | mapi(旧版MD5) | disabled(模拟支付)
ALIPAY_ENABLED=true
ALIPAY_GATEWAY_MODE=openapi
ALIPAY_MODE=cert
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=2021006161653361
ALIPAY_SELLER_ID=2021006161653361
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_KEY_TYPE=PKCS8
# 证书模式 — 文件路径（相对于 server/ 运行目录）
ALIPAY_APP_PRIVATE_KEY_PATH=./keys/alipay/alipay_app_private_key.pem
ALIPAY_APP_CERT_PATH=./keys/alipay/appCertPublicKey_2021006161653361.crt
ALIPAY_PUBLIC_CERT_PATH=./keys/alipay/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=./keys/alipay/alipayRootCert.crt
# 通用回调
ALIPAY_NOTIFY_URL=https://zj.100qiu.com/api/payments/notify
ALIPAY_RETURN_URL=https://zj.100qiu.com/#payment-result

# 定时爬取配置
AUTO_CRAWL_ENABLED=false
AUTO_CRAWL_CRON=0 7 * * *

# ── 邮件告警配置 ──
# 告警总开关（false 禁用）
ALERT_ENABLED=true
# 收件人邮箱
ALERT_RECIPIENT=31788517@qq.com
# QQ邮箱 SMTP 配置（需在QQ邮箱设置中开启SMTP服务并获取授权码）
ALERT_SMTP_HOST=smtp.qq.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=your_sender@qq.com
ALERT_SMTP_PASS=your_smtp_authorization_code
