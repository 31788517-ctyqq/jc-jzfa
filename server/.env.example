# ============ 竞彩推荐监控 - 环境配置模板 ============
PORT=3000
NODE_ENV=production

# 第三方数据源凭证（必填）
MIDOU_BASE_URL=https://midou310.com/mdsj
MIDOU_MOBILE=your_mobile
MIDOU_PASSWORD=your_password

# CORS 允许域名（逗号分隔，生产环境改为实际域名）
ALLOWED_ORIGINS=http://localhost:3000

# ── 支付宝密钥模式（RSA 签名，无证书，来源：群彩网 quncai.com）──
ALIPAY_ENABLED=true
ALIPAY_MODE=key
ALIPAY_SANDBOX=false
ALIPAY_APP_ID=2088011858967984
ALIPAY_SELLER_ID=2088011858967984
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
ALIPAY_SIGN_TYPE=RSA
ALIPAY_NOTIFY_URL=https://zj.100qiu.com/api/payments/notify
ALIPAY_RETURN_URL=https://zj.100qiu.com/preview/index.html#payment-result
# RSA 应用私钥（PEM 格式，来源：quncai qcPrivateKey）
ALIPAY_APP_PRIVATE_
# 支付宝公钥（PEM 格式，来源：quncai rsaNotifyVeryfy.alipayPublicKey）
ALIPAY_ALIPAY_PUBLIC_KEY=MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQCnxj/9qwVfgoUh/y2W89L6BkRAFljhNhgPdyPuBV64bfQNN1PjbCzkIM6qRdKBoLPXmKKMiFYnkd6rAoprih3/PrQEB/VsW8OoM8fxn67UDYuyBTqA23MML9q1+ilIZwBC2AQ2UBVOrFXfFl75p6/B5KsiNG9zpgmLCUYuLkxpLQIDAQAB

# 定时爬取配置
AUTO_CRAWL_ENABLED=false
AUTO_CRAWL_CRON=0 7 * * *

# ── 邮件告警配置 ──
# 告警总开关（false 禁用）
ALERT_ENABLED=true
# 收件人邮箱
ALERT_RECIPIENT=31788517@qq.com
# QQ邮箱 SMTP 配置（需在QQ邮箱设置中开启SMTP服务并获取授权码）
ALERT_SMTP_HOST=smtp.qq.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USER=your_sender@qq.com
ALERT_SMTP_PASS=your_smtp_authorization_code
